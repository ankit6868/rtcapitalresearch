# ==================================================================
#  RT Capital Research — environment variables
# ==================================================================
#
#  LOCAL DEV: leave the Supabase variables empty.
#             The app will use JSON files under ./data/ for storage.
#
#  PRODUCTION (Supabase): fill in all three variables.
#             The app auto-detects them and switches to Supabase.
# ==================================================================

# Your Supabase project URL — Dashboard → Project Settings → API → Project URL
SUPABASE_URL=

# Service role key — Dashboard → Project Settings → API → service_role secret
# WARNING: Keep this secret. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Random string used to sign the admin session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
